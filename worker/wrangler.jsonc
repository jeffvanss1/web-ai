{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotube-dj",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spotube-dj",
      "database_id": "REPLACE_WITH_THE_ID_FROM_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
